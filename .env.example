# ─────────────────────────────────────────────────────────────────────────────
# Local development defaults. `cp .env.example .env.local` and adjust.
# For production values see .env.production.example and DEPLOY.md.
# ─────────────────────────────────────────────────────────────────────────────

# WordPress backend (optional — the app falls back to data/*.json when absent)
# Local: http://localhost:8080 | Production example: https://cms.yourschool.edu.bd
NEXT_PUBLIC_WP_URL=http://localhost:8080
WORDPRESS_API_URL=http://localhost:8080/graphql
WORDPRESS_REST_URL=http://localhost:8080/wp-json/wp/v2

# /admin login key. Sent as the `x-admin-key` header.
# In production this MUST be a long random string: when unset, admin endpoints
# lock themselves (fail closed) instead of falling back to a default.
ADMIN_KEY=cosmo123

# ── Admin login (/admin) ────────────────────────────────────────────────────
# Used by `npm run seed:admin` to create the email + password account.
# If ADMIN_PASSWORD is omitted the seed script generates one and prints it.
ADMIN_EMAIL=admin@cosmoschools.org
# ADMIN_PASSWORD=choose-a-long-password
# ADMIN_NAME=Site Admin
# ADMIN_ROLE=superadmin

# ── Database ────────────────────────────────────────────────────────────────
# Local Docker Postgres maps host port 5434.
# Production: Neon *pooled* connection string (host contains `-pooler`).
DATABASE_URL=postgres://cosmo:cosmo@localhost:5434/cosmo
# Optional: direct (unpooled) URL used by `npm run db:migrate` / `db:seed`.
# DATABASE_URL_MIGRATE=postgres://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ── Uploads ─────────────────────────────────────────────────────────────────
# "disk" → public/uploads (local only; Vercel's fs is read-only)
# "r2"   → Cloudflare R2 (required in production)
# If unset, the driver is inferred: r2 when the R2_* vars are present, else disk.
STORAGE_DRIVER=disk
NEXT_PUBLIC_UPLOADS_URL=/uploads

# Cloudflare R2 (leave blank locally to keep using disk)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=cosmo-media
# Public base URL of the bucket — a custom domain, e.g. https://cdn.cosmoschools.org
# R2_PUBLIC_BASE_URL=

# ── ISR / previews ──────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET=change-me-to-a-long-random-string
PREVIEW_SECRET=change-me-to-another-random-string
