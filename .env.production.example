# ─────────────────────────────────────────────────────────────────────────────
# Production variables — SELF-HOSTED Postgres behind Nginx.
#
# Do NOT commit real secrets. Copy to `.env.production.local` (or `.env` for
# docker compose) and replace every <...>.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Full runbook: docs/DEPLOY-SELFHOSTED.md
# ─────────────────────────────────────────────────────────────────────────────

# ── Postgres (your own server / docker compose service `db`) ────────────────
# Same host as the app → no TLS needed. `db` is the compose service name.
# Public origin for canonical URLs, Open Graph, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://<your-domain>

DATABASE_URL=postgres://cosmo:<password>@db:5432/cosmo
# Used only by `npm run db:migrate:prod` / `db:seed:prod` / `db:transfer`.
DATABASE_URL_MIGRATE=postgres://cosmo:<password>@db:5432/cosmo
# Connection pool size. One Node process uses this many sockets max.
PG_POOL_MAX=10
# Set to `no-verify` only if you terminate TLS with a self-signed certificate.
# PGSSL=no-verify

# Credentials for the compose `db` service (docker-compose.prod.yml reads these).
POSTGRES_DB=cosmo
POSTGRES_USER=cosmo
POSTGRES_PASSWORD=<long-random-password>

# ── Admin + secrets ─────────────────────────────────────────────────────────
ADMIN_KEY=<32-byte-hex>
# Email + password login for /admin (created with `npm run seed:admin:prod`).
ADMIN_EMAIL=admin@cosmoschools.org
# ADMIN_PASSWORD=<long-password>
REVALIDATE_SECRET=<32-byte-hex>
PREVIEW_SECRET=<32-byte-hex>

# ── Uploads ─────────────────────────────────────────────────────────────────
# `disk` writes to public/uploads (volume `uploads`). `r2` uses Cloudflare.
STORAGE_DRIVER=disk
NEXT_PUBLIC_UPLOADS_URL=/uploads
#
# R2_ACCOUNT_ID=<cloudflare-account-id>
# R2_ACCESS_KEY_ID=<r2-token-access-key-id>
# R2_SECRET_ACCESS_KEY=<r2-token-secret-access-key>
# R2_BUCKET=cosmo-media
# R2_PUBLIC_BASE_URL=https://cdn.cosmoschools.org

# ── WordPress (RETIRED) ─────────────────────────────────────────────────────
# The site now reads content from Postgres only. Leave these unset — a
# localhost value in production makes every request wait for a 4–5s timeout.
# NEXT_PUBLIC_WP_URL=
# WORDPRESS_API_URL=
# WORDPRESS_REST_URL=
