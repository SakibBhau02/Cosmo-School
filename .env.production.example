# ─────────────────────────────────────────────────────────────────────────────
# Production variables for Vercel.
#
# Do NOT commit real secrets. Two options:
#   a) paste these into Vercel → Project → Settings → Environment Variables
#   b) copy to .env.production.local and run `vercel env pull/push`
# Values below are placeholders — replace every <...>.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database: Neon ──────────────────────────────────────────────────────────
# Use the POOLED string for the app (host contains `-pooler`).
DATABASE_URL=postgres://<user>:<password>@ep-<id>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
# Direct (unpooled) string, used only by `npm run db:migrate:prod` / `db:seed:prod`.
DATABASE_URL_MIGRATE=postgres://<user>:<password>@ep-<id>.<region>.aws.neon.tech/<db>?sslmode=require

# ── Uploads: Cloudflare R2 ──────────────────────────────────────────────────
STORAGE_DRIVER=r2
R2_ACCOUNT_ID=<cloudflare-account-id>
R2_ACCESS_KEY_ID=<r2-token-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-token-secret-access-key>
R2_BUCKET=cosmo-media
# Custom domain attached to the bucket (Cloudflare → R2 → Settings → Custom Domains)
R2_PUBLIC_BASE_URL=https://cdn.cosmoschools.org

# ── Admin + secrets ─────────────────────────────────────────────────────────
# 32+ random chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_KEY=<32-byte-hex>
REVALIDATE_SECRET=<32-byte-hex>
PREVIEW_SECRET=<32-byte-hex>

# ── WordPress (OPTIONAL) ────────────────────────────────────────────────────
# Leave unset to serve content from data/*.json + Postgres. Set it only if a
# WordPress instance is actually reachable from the public internet — a
# localhost value in production makes every request wait for a 4-5s timeout.
# NEXT_PUBLIC_WP_URL=
# WORDPRESS_API_URL=
# WORDPRESS_REST_URL=
